#!/bin/sh
# The program's build: « sh /src/bee/relay/build », in a container without network that holds the skeleton (this
# script, rules.py, main.rs) and one program (src/), and neither the corpus nor another program. It leaves the
# program as /out/run.  (BEE_SRC and BEE_OUT name other folders than /src and /out: bee/check gives them, the judge
# does not.)
#
# The program is linked statically, and against nothing but itself: a phase runs in a container that holds no
# library and no file of any system, so everything the program needs is in the one file that is counted. The frame
# (main.rs) holds neither the standard library nor the C library: it has its own start, its own system calls, its
# own allocator and its own memcpy, memmove, memset and memcmp, so the program is linked with -nostartfiles
# -nostdlib -static, as a position-dependent program (relocation-model=static), which nothing has to relocate when
# it starts. Three more options only lay the file out tighter, and change no instruction: code and read-only data
# share pages (-z noseparate-code), no build id is written (--build-id=none), and no page is set aside to be made
# read-only after relocation (-z norelro), since nothing is relocated. Together they take some 7.8 kB off the file.
#
# What is built: the program's files as one crate without the standard library and without unsafe code, whose root
# rules.py writes once it has held each file to the project's rule; then the project's own frame (main.rs), which
# reads one file, calls the crate and writes one file.
set -eu
# The judge's tools, by where they are: rustc, cc (with the assembler and the linker gcc calls through the PATH) and
# python3 of /usr/bin, whatever another folder of a caller's PATH holds. (In the judge's image nothing comes before
# them; bee/check sets the same PATH before it calls this.)
PATH=/usr/bin:/bin
export PATH
src="${BEE_SRC:-/src}" out="${BEE_OUT:-/out}"

# One compiler: the release the judge's image packages. Another one is the machine's fault, not a program's.
found=$(rustc --version)
case "$found" in
  "rustc 1.75."*) ;;
  *) echo "build: this project is built with rustc 1.75 (found: $found)" >&2; exit 3 ;;
esac

# A fixed place beside the output, in the build's own bounded folder (the manifest's output_mb): the same paths at
# every build, so the same program; the compiler's and the linker's own scratch files go there too.
work="$out/work"
rm -rf "$work"
mkdir -p "$work"
export TMPDIR="$work"
python3 "$src/bee/relay/rules.py" "$src/src" "$work/lib.rs"
common="--edition 2021 -C opt-level=3 -C codegen-units=1 -C panic=abort -C debuginfo=0 -C strip=symbols -C target-feature=+crt-static -C relocation-model=static -C overflow-checks=off -C debug-assertions=off"
alone="-C link-arg=-nostartfiles -C link-arg=-nostdlib -C link-arg=-static -C link-arg=-Wl,-z,noseparate-code -C link-arg=-Wl,--build-id=none -C link-arg=-Wl,-z,norelro"
# shellcheck disable=SC2086
rustc $common -F unsafe_code --crate-type rlib --crate-name program -o "$work/libprogram.rlib" "$work/lib.rs"
# shellcheck disable=SC2086
rustc $common $alone --extern program="$work/libprogram.rlib" -o "$out/run" "$src/bee/relay/main.rs"
rm -rf "$work"
