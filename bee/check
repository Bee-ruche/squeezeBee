#!/bin/bash
# The project's quick check, for a worker, IN THE SANDBOX (bee/README.md): builds the program as the judge does
# (the same script, the same rule, the same compiler) and takes a slice of the corpus there and back.
#
#   bee/check [bytes [file]]      bytes: how much of the file (default 1000000; 0: all of it)
#                                 file:  the data (default: the project's corpus, bee/corpus/data)
#
# It prints the figures the judge counts (the program's bytes, the message's bytes, their total) and the processor
# time of each phase, on this machine. It ends with 0 only if what comes back is what went in, byte for byte.
# It proves nothing to the hive: the judge runs each phase alone in a container, twice, on the whole corpus.
#
# It checks with the judge's own toolchain or not at all (exit 3, and why), as the build calls it, by name:
# /usr/bin/rustc 1.75 (the judge's is Ubuntu 24.04's), /usr/bin/cc and the static C library it links into the program
# (by the absolute path gcc gives when it has one), /usr/bin/python3 for the project's rule. Another compiler would
# build what the judge's refuses (a later release's language) and weigh the program otherwise. What this test does
# not establish (gcc's and the C library's own versions, among others) is in bee/README.md, "The sandbox".
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
bytes="${1:-1000000}"
data="${2:-$root/bee/corpus/data}"
[ -f "$data" ] || { echo "check: no data at $data" >&2; exit 2; }
missing=()
# By name, as the build calls it: the first one on the PATH. Both forms of the sandbox set a PATH where /usr/bin comes
# before /bin (the launcher's own, /usr/local/bin:/usr/bin:/bin; the image's, Ubuntu's default), so on a machine whose
# /bin is /usr/bin (merged /usr) the answer there is /usr/bin/<name>. Run with /bin first, outside both forms, this
# refuses where it need not: the side of caution, and this check is not run outside them.
where() { command -v "$1" 2>/dev/null || echo none; }
compiler=
if [ "$(where rustc)" != /usr/bin/rustc ]; then
  missing+=("rustc: $(where rustc), where the judge's is /usr/bin/rustc (a compiler in a home folder is not seen in the sandbox without Docker)")
else
  compiler="$(rustc --version 2>/dev/null || true)"
  case "$compiler" in
    "rustc 1.75."*) ;;
    *) missing+=("/usr/bin/rustc is ${compiler:-not a compiler that answers}, where the judge's is rustc 1.75") ;;
  esac
fi
if [ "$(where cc)" != /usr/bin/cc ]; then
  missing+=("cc: $(where cc), where the judge's linker is /usr/bin/cc (gcc)")
else
  libc="$(cc -print-file-name=libc.a 2>/dev/null || true)"
  case "$libc" in
    /*) [ -f "$libc" ] || missing+=("no static C library ($libc), which the judge links into the program") ;;
    *) missing+=("no static C library (libc.a: gcc knows none), which the judge links into the program") ;;
  esac
fi
[ "$(where python3)" = /usr/bin/python3 ] || missing+=("python3: $(where python3), where the judge's is /usr/bin/python3 (it runs the project's rule)")
if [ ${#missing[@]} -gt 0 ]; then
  printf 'check: %s\n' "${missing[@]}" >&2
  echo "check: this is not the judge's own toolchain, so this check cannot say what the judge will answer: stop." >&2
  exit 3
fi
echo "compiler $compiler"
[ "$(uname -m)" = x86_64 ] || echo "note: an $(uname -m) program: program_bytes is not the judge's (x86-64); message_bytes is"
out=/tmp/bee-check
rm -rf "$out"
mkdir -p "$out"
BEE_SRC="$root" BEE_OUT="$out" sh "$root/bee/relay/build"
if [ "$bytes" = 0 ]; then cp "$data" "$out/data"; else head -c "$bytes" "$data" > "$out/data"; fi
TIMEFORMAT='%U %S'
# (The program reads descriptor 3 and writes descriptor 4: here the shell opens them; in the judge, its gate does.)
encode="$( { time "$out/run" encode 3<"$out/data" 4>"$out/message"; } 2>&1 | tail -n 1)"
decode="$( { time "$out/run" decode 3<"$out/message" 4>"$out/back"; } 2>&1 | tail -n 1)"
program="$(wc -c < "$out/run")"
message="$(wc -c < "$out/message")"
echo "data_bytes $(wc -c < "$out/data")"
echo "program_bytes $program"
echo "message_bytes $message"
echo "total_bytes $((program + message))"
echo "encode_seconds (user system) $encode"
echo "decode_seconds (user system) $decode"
if cmp -s "$out/data" "$out/back"; then
  echo "round trip: the same bytes"
else
  echo "round trip: NOT the same bytes" >&2
  exit 1
fi
